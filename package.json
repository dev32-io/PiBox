{
  "name": "pibox",
  "version": "0.1.0",
  "description": "An original cool-steel visual TUI package for the Pi coding agent",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "pi-theme",
    "tui"
  ],
  "files": [
    "extensions",
    "themes",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "find extensions -name '*.test.ts' -print0 | xargs -0 tsx --test",
    "verify": "npm run check && npm test"
  },
  "pi": {
    "extensions": [
      "./extensions/providers/ollama-cloud/index.ts",
      "./extensions/providers/local-llm/index.ts",
      "./extensions/tui/chat-input/index.ts",
      "./extensions/tui/status-bar/index.ts",
      "./extensions/tui/styled-outputs/index.ts",
      "./extensions/tui/spinners/index.ts",
      "./extensions/tui/startup/index.ts"
    ],
    "themes": [
      "./themes/rattle.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
