{
  "name": "pibox",
  "version": "0.1.0",
  "description": "A cool-steel visual, feedback, and provider package for the Pi coding agent",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "pi-theme",
    "tui"
  ],
  "files": [
    "extensions",
    "themes",
    "sound-themes",
    "skills",
    "services",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "find extensions skills benchmarks -name '*.test.ts' -print0 | xargs -0 tsx --test",
    "verify": "npm run check && npm test",
    "eval:prompt": "tsx benchmarks/prompt-scenarios/cli.ts",
    "eval:workflow": "tsx extensions/workflow-scenarios/run-deterministic.ts",
    "eval:workflow:model": "tsx extensions/workflow-scenarios/run-model-suite.ts",
    "eval:workflow:model:score": "tsx extensions/workflow-scenarios/run-model-score.ts",
    "eval:workflow:compare": "tsx extensions/workflow-scenarios/run-compare.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/permissions/index.ts",
      "./extensions/fast-mode/index.ts",
      "./extensions/provider-fallback/index.ts",
      "./extensions/workflow-runtime/index.ts",
      "./extensions/workflow/index.ts",
      "./extensions/rule/index.ts",
      "./extensions/distill/index.ts",
      "./extensions/service-adapter/index.ts",
      "./extensions/memory-adapter/index.ts",
      "./extensions/visual-companion/index.ts",
      "./extensions/feedback/sound-hooks/index.ts",
      "./extensions/providers/ollama-cloud/index.ts",
      "./extensions/providers/codex-usage/index.ts",
      "./extensions/providers/local-llm/index.ts",
      "./extensions/tui/chat-input/index.ts",
      "./extensions/tui/effort/index.ts",
      "./extensions/tui/status-bar/index.ts",
      "./extensions/tui/styled-outputs/index.ts",
      "./extensions/tui/spinners/index.ts",
      "./extensions/tui/startup/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes/rattle.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typebox": "^1.3.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "cytoscape": "^3.33.1",
    "yaml": "^2.9.0"
  }
}
